<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive Icon 前景层，108×108dp 画布。
  Safe zone：以 (54,54) 为圆心、半径 33dp 的圆（直径 66dp）。
  所有路径顶点距圆心均 ≤32.8dp，已通过验证。

  设计：两枚反向箭头（⇄），表示汇率双向兑换。
  上箭头（→）圆心 y=43，下箭头（←）圆心 y=65，整体垂直居中 y=54。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <group android:scaleX="0.7"
      android:scaleY="0.7"
      android:translateX="16.2"
      android:translateY="16.2">

      <!-- 上箭头，指向右 → （轴 x26-68，箭头朝右至 x82） -->
      <path
          android:fillColor="#FFFFFF"
          android:pathData="M 26,37 L 68,37 L 68,30 L 82,43 L 68,56 L 68,49 L 26,49 Z" />

      <!-- 下箭头，指向左 ← （轴 x40-82，箭头朝左至 x26） -->
      <path
          android:fillColor="#FFFFFF"
          android:pathData="M 82,59 L 40,59 L 40,52 L 26,65 L 40,78 L 40,71 L 82,71 Z" />

  </group>
</vector>
